# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Deployment URL (update for production)
# For local development: http://localhost:3000
# For production (Vercel): https://kwizme.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@yourdomain.com,your-email@domain.com

# Discord Webhook for Feedback
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Discord Webhook for Error Alerts (separate from feedback)
# Create a dedicated webhook for error notifications in your Discord server
DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/your-error-webhook-id/your-error-webhook-token

# Discord Webhook for Positive Notifications (user signups, quiz generation)
# Create a dedicated webhook for celebratory notifications in your Discord server
DISCORD_NOTIFICATIONS_WEBHOOK_URL=https://discord.com/api/webhooks/your-notifications-webhook-id/your-notifications-webhook-token
